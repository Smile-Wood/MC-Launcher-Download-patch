<Window x:Class="PCL.Injector.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCL-Injector" Height="720" Width="860"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <Style TargetType="Border" x:Key="SectionBorder">
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="#FAFAFA"/>
        </Style>
        <Style TargetType="Button" x:Key="ActionBtn">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 固定比例行: 保证日志区有界, TextBox 内部 ScrollViewer 才能生效 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部选项 ===== -->
        <Border Grid.Row="0" Style="{StaticResource SectionBorder}">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="ChkAutoStart" Content="启动时自动注入选中的启动器"
                          Margin="8,4" Checked="ChkOption_Changed" Unchecked="ChkOption_Changed"/>
                <CheckBox x:Name="ChkSilentMode" Content="静默模式 (注入启动后自动缩小到托盘)"
                          Margin="16,4" Checked="ChkOption_Changed" Unchecked="ChkOption_Changed"/>
            </StackPanel>
        </Border>

        <!-- ===== 单选启动器配置 ===== -->
        <Border Grid.Row="1" Style="{StaticResource SectionBorder}">
            <DockPanel>
                <!-- 底部操作按钮 -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="＋ 添加启动器" Click="BtnAddLauncher_Click" Style="{StaticResource ActionBtn}"/>
                    <Button Content="🔍 探测运行中的启动器" Click="BtnAutoDetect_Click" Style="{StaticResource ActionBtn}"/>
                    <TextBlock x:Name="TxtStatus" Text="就绪" Foreground="Gray"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>

                <!-- 单选列表 (自带滚动, 不挤占日志区) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
                    <ItemsControl x:Name="IcLaunchers">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3" BorderBrush="#CCC" BorderThickness="1"
                                        CornerRadius="3" Padding="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton GroupName="LauncherGroup"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                     Checked="Radio_Selected"
                                                     VerticalAlignment="Center" Margin="2,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding KindString}" FontWeight="Bold"
                                                   Foreground="#0066CC" VerticalAlignment="Center"
                                                   Margin="0,0,8,0" Width="72"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PathDisplay}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Content="浏览" Padding="8,2" Margin="4,0"
                                                Click="BtnBrowse_Click"/>
                                        <Button Grid.Column="4" Content="探测" Padding="8,2" Margin="4,0"
                                                Click="BtnDetect_Click"/>
                                        <Button Grid.Column="5" Content="✕" Padding="8,2" Margin="4,0"
                                                Click="BtnRemove_Click" Foreground="Red"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== 注入控制 + 日志 (有界区域, 自动滚动) ===== -->
        <Border Grid.Row="2" Style="{StaticResource SectionBorder}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button x:Name="BtnStart" Content="▶ 开始注入" Click="BtnStart_Click"
                            Style="{StaticResource ActionBtn}" Background="#4CAF50" Foreground="White"/>
                    <Button Content="📁 打开日志目录" Click="BtnOpenLogDir_Click" Style="{StaticResource ActionBtn}"/>
                </StackPanel>
                <TabControl>
                    <TabItem Header="monitor.log (注入器侧)">
                        <TextBox x:Name="TxtMonitorLog" IsReadOnly="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12"
                                 Background="#1E1E1E" Foreground="#D4D4D4"/>
                    </TabItem>
                    <TabItem Header="inject.log (Payload侧)">
                        <TextBox x:Name="TxtInjectLog" IsReadOnly="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12"
                                 Background="#1E1E1E" Foreground="#D4D4D4"/>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
    </Grid>
</Window>
